# Variables lues par docker-compose.yml (copier en .env à la racine).
POSTGRES_DB=antifake
POSTGRES_USER=antifake
POSTGRES_PASSWORD=change-me

# Adresse de l'API vue par le NAVIGATEUR (figée au build du front).
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=Plateforme anti-fake news
