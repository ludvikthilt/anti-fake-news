# Variables lues par docker-compose.yml (copier en .env à la racine).
POSTGRES_DB=antifake
POSTGRES_USER=antifake
POSTGRES_PASSWORD=change-me

# Adresse de l'API lue à l'exécution par le front (et figée au build par défaut).
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=InfoxVerify
# Identifiant OAuth public servi par /runtime-config.js (aucun secret).
GOOGLE_CLIENT_ID=
