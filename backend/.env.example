# --- Développement local ---
DEBUG=true
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=*
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/antifake
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Production (voir DEPLOIEMENT.md) ---
# DEBUG=false
# DJANGO_SECRET_KEY=<50 caractères aléatoires minimum>
# ALLOWED_HOSTS=antifake.exemple.com
# CSRF_TRUSTED_ORIGINS=https://antifake.exemple.com
# CORS_ALLOWED_ORIGINS=https://antifake.exemple.com
# SECURE_SSL_REDIRECT=true
# CACHE_BACKEND=db
# LOG_LEVEL=INFO
# GUNICORN_WORKERS=3
# MAX_REQUEST_BYTES=12582912
# DJANGO_SUPERUSER_EMAIL=admin@exemple.com
# DJANGO_SUPERUSER_PASSWORD=<mot de passe solide>

# Cache d'analyse (heures) et seuil d'alerte des quotas fournisseurs
CACHE_TTL_TEXT_HOURS=6
CACHE_TTL_IMAGE_HOURS=24
QUOTA_ALERT_RATIO=0.8

# IA / RAG — récupération : Gemini (embeddings) → plein texte → mots-clés
# Génération : Gemini → Groq → stub
AI_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_MODEL_FALLBACK=gemini-3.5-flash
EMBEDDING_DIM=768
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Recherche de texte et d'image
SEARCH_PROVIDER=manual
TAVILY_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=
SEARCHAPI_API_KEY=
EXA_API_KEY=

# Vérifications de faits, OCR, recherche d'image
# OCR : OCR.space, puis saisie manuelle (silencieux).
FACTCHECK_API_KEY=
OCRSPACE_API_KEY=
APIFY_API_KEY=
APIFY_LENS_ACTOR=borderline~google-lens
IMAGE_ENRICH_BUDGET_SECONDS=180

# E-mail (Brevo)
BREVO_API_KEY=
# Expéditeur Brevo : adresse VÉRIFIÉE dans Brevo (Senders & IPs → Senders).
# Brevo répond 201 puis rejette en arrière-plan si elle n'est pas validée.
EMAIL_FROM=ludviktybho@gmail.com

# Connexion Google (OpenID Connect)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/compte/google/callback

# Planificateur (M13) et hébergement éphémère des images
INTERNAL_TOKEN=dev-internal-token
BACKEND_BASE_URL=http://127.0.0.1:8000

# Telegram — canal gratuit et illimité (@BotFather → /newbot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Web Push (PWA) — clé privée base64url (32 octets), publique dérivée
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@antifake.local
